{
  "plugin": "custom",
  "pluginConfig": {
    "invoke_interval": "200s",
    "timeout": "60s",
    "max_output_length": 256,
    "concurrency": 1
  },
  "source": "memfragment-custom-plugin-monitor",
  "conditions": [
    {
      "type": "MemFragment",
      "reason": "NodeHasNoMemFragment",
      "message": "node has no Memory Fragment" 
    }
  ],
  "rules": [
    {
      "type": "permanent",
      "condition": "MemFragment",
      "reason": "NodeHasMemFragment",
      "path": "./config/plugin/memfrag.sh",
      "message": "Node has  memory fragment"
    }
  ]
}
