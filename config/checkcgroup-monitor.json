{
  "plugin": "custom",
  "pluginConfig": {
    "invoke_interval": "200s",
    "timeout": "60s",
    "max_output_length": 256,
    "concurrency": 1
  },
  "source": "checkcgroup-custom-plugin-monitor",
  "conditions": [
    {
      "type": "cgroupPressure",
      "reason": "NodeHasNoCgroupOverflow",
      "message": "node has no cgroup overflows"
    }
  ],
  "rules": [
    {
      "type": "permanent",
      "condition": "cgroupPressure",
      "reason": "NodeHasCgroupOverflow",
      "path": "/home/kubernetes/bin/checkcgroup",
	  "args": [
	  "--t=1000"
	],
      "message": "kernel has cgroup overflows"
    }
  ]
}
